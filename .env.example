# Neverseen agent configuration.
#
# Copy to .env and edit. Every variable the agent reads is listed here, and a
# test fails the build in both directions: a variable the code reads and this
# file does not mention, and a variable this file documents that no code reads.
# A documented surface that goes stale is worse than none, because an operator
# trusts it.
#
# The agent reads ~/.neverseen/.env itself, on every platform. A variable already
# set in the environment wins over the file: the file is the standing
# configuration and a variable is a deliberate override for this run.

# --- what to look for -------------------------------------------------------

# Which country pattern sets to load. A code, several separated by commas, or
# "none". Unset means none.
#
#   fr     France — NIR, SIREN, SIRET, postcode and commune, address, plate,
#          telephone, day-first dates
#   gb     United Kingdom — NHS number, National Insurance number, postcode,
#          telephone
#   us     United States — social security number, employer id, ABA routing
#          number, telephone, street address, ZIP
#   none   the locale-independent sets only
#
# The locale-independent identifiers always load whatever this says: email,
# payment cards, IBAN (every issuing country), IP addresses, MongoDB ids, ISO
# dates, and every credential.
#
# Mixing locales is supported and is what a company operating in several
# countries wants. It costs some precision where two countries issue
# identifiers of the same length: nine bare digits are a French SIREN under one
# checksum and a US routing number under another, and a number satisfying both
# is named by whichever locale loads first.
NEVERSEEN_PII_LOCALE=fr

# Values never to mask, separated by commas. Compared ignoring case and
# spacing, so declaring an account in its compact form also covers the grouped
# spelling of the same value.
#
# This is the escape hatch for the shapes no checksum can settle — a nine-digit
# fleet id that passes Luhn and reads as a SIREN, the company's own office
# address.
# NEVERSEEN_PII_ALLOWLIST=123456789,10 Downing Street

# --- what a masked value looks like -----------------------------------------

# "token" replaces a value with [EMAIL_1]: unmistakably not data, and restored
# in the answer the caller reads.
#
# "fake" replaces it with a stand-in of the same shape, so the prompt reaches
# the model as prose. Stand-ins are unattributable by construction — reserved
# ranges and deliberately invalid checksums — and are NOT expanded on the way
# back, because the point of one is that it reads as prose. The mapping still
# records the pair. Credentials always take a token, whatever this says: a
# stand-in that looks like a working key is a thing somebody will try to use.
NEVERSEEN_PII_SUBSTITUTION=token

# --- serving ----------------------------------------------------------------

# How far down the strength scale a named secret is masked: weak, medium or strong.
# Only the catch-all pattern is graded — the credentials identified by a prefix
# ("gsk_", "sk-ant-") are masked at every level, because a setting that could stop
# masking a real key would be one whose only effect is to leak.
#
#   weak    everything the pattern finds, including ordinary words. What this agent
#           did before the level existed, and what over-masks source code.
#   medium  values mixing two kinds of character.
#   strong  three or more, or long enough that nobody typed it. The level to run at
#           while reviewing code: almost no identifier reaches it.
#
# The starting value only. The menu bar, `neverseen mask` and PUT /policy move it
# while the agent runs, exactly as they do the substitution mode.
NEVERSEEN_SECRET_LEVEL=weak

# Address to listen on. The loopback default is not a default to override
# lightly: the agent forwards whatever credential its caller sent and scopes the
# session mapping by a header the caller controls, so it is built for one person
# on one workstation. Bound to a reachable interface it becomes a way to read
# another user's session.
#
# `neverseen proxy -l` is the same setting for a one-off run, and wins over this.
# Either way, the agent warns on every start when the result is reachable.
NEVERSEEN_LISTEN=127.0.0.1:9787

# Upstream overrides, as code=url pairs separated by commas. An override, not a
# replacement: the seven providers you do not name keep their defaults. Known
# codes are anthropic, openai, gemini, mistral, groq, together, deepinfra, xai.
# NEVERSEEN_PROVIDERS=anthropic=https://gateway.internal

# The 32-byte key, hex-encoded, that the session mapping is sealed with. Unset
# means one is generated for the life of the process — which is the right
# default while the mapping lives in memory, and has to become a real setting
# the day it lives anywhere shared.
# NEVERSEEN_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# --- supervision (the paid half; the agent is complete without it) ----------

# A supervision backend. Unset — the normal case — means no supervision at all:
# no reporter is built, nothing is sent anywhere, and the agent is otherwise
# identical. That is a whole feature rather than a disabled one.
#
# What a supervised agent sends is counters and configuration: how many requests
# it proxied, how many values it masked in which categories, and how many tokens
# went to which model. Never a prompt, never a response, never a detected value,
# never a file name or a URL. The contract in pkg/telemetry has a test that walks
# its own type and fails on any string field nobody argued for, so the claim is
# checked rather than promised.
# NEVERSEEN_BACKEND_URL=https://supervision.example.com

# The enrolment token the backend gave you. Presented once and traded for an
# identity of this agent's own, which is what makes one workstation revocable
# without touching the others — a shared secret copied everywhere is the thing
# that cannot be revoked for one of them.
# NEVERSEEN_ENROLMENT_TOKEN=

# Where that issued identity is kept. It holds a signing key, so the file and its
# directory are created readable by their owner only.
# NEVERSEEN_IDENTITY_FILE=~/.neverseen/agent.json
